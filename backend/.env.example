# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL="mysql://root:@localhost:3306/renthub"

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OTP
OTP_EXPIRES_IN_MINUTES=10

# Public URL of the frontend (links in SMS receipts and reminders)
APP_URL=http://localhost:3000

# Online payments (SSLCommerz). Each workspace enters its own store in Settings.
# GATEWAY_KEY encrypts the store passwords; set a long random string and never change it.
GATEWAY_KEY=
# Public URL of the API, for the gateway's return and IPN calls (defaults to APP_URL, which proxies /api)
# API_PUBLIC_URL=https://renthub.example.com

# SMS: "console" prints messages to the server log; "http" calls your gateway.
# For http, SMS_HTTP_URL is a template: {to} {text} {sender} {key} are filled in, e.g.
# SMS_HTTP_URL=https://gateway.example/api/smsapi?api_key={key}&type=text&number={to}&senderid={sender}&message={text}
SMS_DRIVER=console
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Text that marks success in the gateway's response (empty = any HTTP 2xx)
SMS_HTTP_OK=
