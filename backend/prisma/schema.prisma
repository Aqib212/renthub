generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  USER
}

/// Role of a user inside one organisation (workspace).
enum OrgRole {
  OWNER
  MANAGER
  CARETAKER
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum FlatStatus {
  VACANT
  OCCUPIED
  NOTICE
  UNDER_MAINTENANCE
}

/// What an Asset is. Vehicles arrive in phase 6 with their own detail table.
enum AssetKind {
  UNIT
  VEHICLE
}

enum VehicleType {
  CNG
  TAXI
  CAR
  MICROBUS
  OTHER
}

/// ON_LEASE is set from agreements (syncAssetStatus); OFF_ROAD by a blocking maintenance request.
enum VehicleStatus {
  AVAILABLE
  ON_LEASE
  OFF_ROAD
  /// out on a rent-a-car booking
  ON_TRIP
}

enum BookingStatus {
  RESERVED
  ON_TRIP
  DONE
  CANCELLED
}

enum UnitType {
  FLAT
  ROOM
  SEAT
  SHOP
  GARAGE
}

enum ElectricityMode {
  SUBMETER
  PREPAID
  SHARED
}

enum PartyKind {
  PERSON
  COMPANY
}

/// MONTHLY (houses, monthly car leases) and DAILY (driver jama); WEEKLY and TRIP are reserved.
enum BillingCycle {
  MONTHLY
  DAILY
  WEEKLY
  TRIP
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  NOTICE
  ENDED
}

enum Lang {
  BN
  EN
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum DepositType {
  RECEIVED
  ADJUSTED
  DEDUCTED_DAMAGE
  REFUNDED
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  BANK
  CHEQUE
  /// deposit adjusted against dues at move-out (not cash received)
  DEPOSIT
  /// tax a company tenant withheld and paid to the government (challan no. in transactionId)
  TDS
}

enum ExpenseCategory {
  LIFT
  SECURITY
  CLEANING
  COMMON_ELECTRICITY
  REPAIRS
  MAINTENANCE
  MISC
  HOLDING_TAX
  STAFF_SALARY
}

enum CalcMethod {
  FIXED
  METERED
  SLAB
  PER_PERSON
  MANUAL
  /// one building bill split across the units (see BuildingBill)
  SHARED
}

enum SplitRule {
  EQUAL
  PER_PERSON
  PER_SQFT
}

enum MaintenanceStatus {
  NEW
  ASSIGNED
  WAITING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum NoticeRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum DocumentKind {
  NID
  AGREEMENT
  PHOTO
  UTILITY
  OTHER
  REGISTRATION
  FITNESS
  TAX_TOKEN
  ROUTE_PERMIT
  INSURANCE
  LICENCE
  ENLISTMENT
}

model User {
  id                  BigInt     @id @default(autoincrement())
  email               String     @unique @db.VarChar(255)
  phone               String?    @unique @db.VarChar(20)
  password            String     @db.VarChar(255)
  firstName           String     @db.VarChar(100)
  lastName            String     @db.VarChar(100)
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  emailVerified       Boolean    @default(false)
  phoneVerified       Boolean    @default(false)
  avatar              String?    @db.Text
  refreshToken        String?    @db.Text
  otp                 String?    @db.VarChar(6)
  otpExpiresAt        DateTime?
  otpPurpose          String?    @db.VarChar(20)
  resetToken          String?    @db.Text
  resetTokenExpiresAt DateTime?
  loginAttempts       Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  ownerProfile OwnerProfile?
  auditLogs    AuditLog[]
  memberships  Membership[]

  @@map("users")
}

/// A landlord business (workspace). Every business row belongs to one.
model Organization {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(200)
  plan      String   @default("FREE") @db.VarChar(30)
  unitLimit Int?
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  buildings     Building[]
  tenants       Tenant[]
  billTypes     BillType[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  assets        Asset[]
  agreements    Agreement[]
  counters      OrgCounter[]
  notifications Notification[]
  handovers     CashHandover[]
  buildingBills BuildingBill[]
  maintenance   MaintenanceRequest[]
  documents     Document[]
  auditLogs     AuditLog[]
  claims        PaymentClaim[]
  notices       NoticeRequest[]
  vehicles      Vehicle[]
  bookings      Booking[]

  @@map("organizations")
}

model Membership {
  id          BigInt       @id @default(autoincrement())
  userId      BigInt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId       BigInt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role        OrgRole
  /// null = all buildings; otherwise an array of building ids this member may see
  buildingIds Json?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  collected           Payment[]            @relation("CollectedBy")
  handoversGiven      CashHandover[]       @relation("HandoverFrom")
  handoversReceived   CashHandover[]       @relation("HandoverTo")
  maintenanceAssigned MaintenanceRequest[] @relation("MaintenanceAssignee")
  maintenanceCreated  MaintenanceRequest[] @relation("MaintenanceCreator")
  documentsUploaded   Document[]
  claimsReviewed      PaymentClaim[]       @relation("ClaimReviewer")
  dayEntries          DayEntry[]
  noticesReviewed     NoticeRequest[]      @relation("NoticeReviewer")
  bookings            Booking[]

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

model OwnerProfile {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nid              String?  @db.VarChar(50)
  passport         String?  @db.VarChar(50)
  drivingLicense   String?  @db.VarChar(50)
  occupation       String?  @db.VarChar(100)
  office           String?  @db.VarChar(255)
  emergencyContact String?  @db.VarChar(20)
  presentAddress   String?  @db.Text
  permanentAddress String?  @db.Text
  photo            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("owner_profiles")
}

model AuditLog {
  id        BigInt        @id @default(autoincrement())
  /// null when a tenant acted through the portal (tenantId is set instead)
  userId    BigInt?
  user      User?         @relation(fields: [userId], references: [id])
  tenantId  BigInt?
  tenant    Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  orgId     BigInt?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action    String        @db.VarChar(100)
  entity    String?       @db.VarChar(100)
  entityId  String?
  metadata  Json?
  ipAddress String?       @db.VarChar(45)
  userAgent String?       @db.Text
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model Building {
  id            BigInt       @id @default(autoincrement())
  orgId         BigInt
  org           Organization @relation(fields: [orgId], references: [id])
  name          String       @db.VarChar(200)
  holdingNumber String?      @db.VarChar(100)
  address       String?      @db.Text
  ward          String?      @db.VarChar(50)
  area          String?      @db.VarChar(100)
  district      String?      @db.VarChar(100)
  description   String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  floors        Floor[]
  expenses      Expense[]
  buildingBills BuildingBill[]

  @@index([orgId])
  @@map("buildings")
}

model Floor {
  id          BigInt   @id @default(autoincrement())
  buildingId  BigInt
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flats Flat[]

  @@index([buildingId])
  @@map("floors")
}

model Flat {
  id              BigInt          @id @default(autoincrement())
  floorId         BigInt
  floor           Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name            String          @db.VarChar(100)
  flatNumber      String?         @db.VarChar(50)
  bedrooms        Int             @default(0)
  bathrooms       Int             @default(0)
  kitchens        Int             @default(1)
  balconies       Int             @default(0)
  area            Decimal?        @db.Decimal(10, 2)
  /// asking terms for the next agreement; the real ones live on Agreement / DepositEntry
  rent            Decimal         @db.Decimal(12, 2)
  advance         Decimal?        @db.Decimal(12, 2)
  securityDeposit Decimal?        @db.Decimal(12, 2)
  assetId         BigInt          @unique
  asset           Asset           @relation(fields: [assetId], references: [id])
  unitType        UnitType        @default(FLAT)
  /// rooms and seats sit inside a flat
  parentId        BigInt?
  parent          Flat?           @relation("SubUnits", fields: [parentId], references: [id])
  subUnits        Flat[]          @relation("SubUnits")
  electricityMode ElectricityMode @default(SUBMETER)
  toLet           Boolean         @default(false)
  sanctionedLoad  Decimal?        @db.Decimal(8, 2)
  status          FlatStatus      @default(VACANT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  invoices    Invoice[]
  charges     FlatCharge[]
  billEntries BillEntry[]

  @@index([floorId])
  @@index([status])
  @@map("flats")
}

model Tenant {
  id               BigInt       @id @default(autoincrement())
  orgId            BigInt
  org              Organization @relation(fields: [orgId], references: [id])
  firstName        String       @db.VarChar(100)
  lastName         String       @db.VarChar(100)
  phone            String?      @db.VarChar(20)
  /// 8801XXXXXXXXX (normalizeBdPhone); the tenant portal logs in by this
  phoneNormalized  String?      @db.VarChar(13)
  email            String?      @db.VarChar(255)
  nid              String?      @db.VarChar(50)
  passport         String?      @db.VarChar(50)
  drivingLicense   String?      @db.VarChar(50)
  occupation       String?      @db.VarChar(100)
  office           String?      @db.VarChar(255)
  emergencyContact String?      @db.VarChar(20)
  presentAddress   String?      @db.Text
  permanentAddress String?      @db.Text
  photo            String?      @db.Text
  kind             PartyKind    @default(PERSON)
  /// language of the SMS and receipts this person gets
  lang             Lang         @default(BN)
  members          Int          @default(1)
  /// household for the DMP CIMS form: [{ name, relation, age, nid }]
  household        Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  invoices    Invoice[]
  agreements  Agreement[]
  maintenance MaintenanceRequest[]
  documents   Document[]
  auditLogs   AuditLog[]
  claims      PaymentClaim[]
  notices     NoticeRequest[]
  bookings    Booking[]

  @@index([orgId])
  @@index([phoneNormalized])
  @@map("tenants")
}

model BillType {
  id                BigInt       @id @default(autoincrement())
  orgId             BigInt
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String       @db.VarChar(100)
  calcMethod        CalcMethod
  rate              Decimal?     @db.Decimal(12, 2)
  unitLabel         String?      @db.VarChar(20)
  slabs             Json?
  fixedCharge       Decimal?     @db.Decimal(10, 2)
  demandChargePerKw Decimal?     @db.Decimal(10, 2)
  vatPercent        Decimal?     @db.Decimal(5, 2)
  /// how a SHARED building bill is divided
  split             SplitRule?
  appliesToAll      Boolean      @default(true)
  isActive          Boolean      @default(true)
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  flatCharges   FlatCharge[]
  entries       BillEntry[]
  invoiceItems  InvoiceItem[]
  buildingBills BuildingBill[]

  @@unique([orgId, name])
  @@map("bill_types")
}

model FlatCharge {
  id         BigInt   @id @default(autoincrement())
  flatId     BigInt
  flat       Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  billTypeId BigInt
  billType   BillType @relation(fields: [billTypeId], references: [id], onDelete: Cascade)
  amount     Decimal? @db.Decimal(12, 2)
  isActive   Boolean  @default(true)

  @@unique([flatId, billTypeId])
  @@index([billTypeId])
  @@map("flat_charges")
}

model BillEntry {
  id              BigInt   @id @default(autoincrement())
  flatId          BigInt
  flat            Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  billTypeId      BigInt
  billType        BillType @relation(fields: [billTypeId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  previousReading Decimal? @db.Decimal(12, 2)
  currentReading  Decimal? @db.Decimal(12, 2)
  units           Decimal? @db.Decimal(12, 2)
  amount          Decimal? @db.Decimal(12, 2)
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([flatId, billTypeId, month, year])
  @@index([billTypeId])
  @@map("bill_entries")
}

model Invoice {
  id             BigInt        @id @default(autoincrement())
  /// null for vehicle invoices (they have only assetId)
  flatId         BigInt?
  flat           Flat?         @relation(fields: [flatId], references: [id], onDelete: Restrict)
  tenantId       BigInt?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  orgId          BigInt
  org            Organization  @relation(fields: [orgId], references: [id])
  month          Int
  year           Int
  rent           Decimal       @default(0) @db.Decimal(12, 2)
  previousDue    Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  fine           Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime?
  notes          String?       @db.Text
  shareToken     String?       @unique @db.VarChar(64)
  carriedForward Boolean       @default(false)
  /// null only on invoices made before agreements existed
  agreementId    BigInt?
  agreement      Agreement?    @relation(fields: [agreementId], references: [id])
  assetId        BigInt?
  asset          Asset?        @relation(fields: [assetId], references: [id])
  periodStart    DateTime?     @db.Date
  periodEnd      DateTime?     @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments      Payment[]
  items         InvoiceItem[]
  notifications Notification[]
  claims        PaymentClaim[]
  booking       Booking?

  @@unique([agreementId, periodStart])
  @@index([flatId, month, year])
  @@index([orgId, month, year])
  @@index([orgId, status])
  @@index([tenantId])
  @@map("invoices")
}

model InvoiceItem {
  id         BigInt    @id @default(autoincrement())
  invoiceId  BigInt
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billTypeId BigInt?
  billType   BillType? @relation(fields: [billTypeId], references: [id], onDelete: SetNull)
  label      String    @db.VarChar(100)
  detail     String?   @db.VarChar(255)
  quantity   Decimal?  @db.Decimal(12, 2)
  rate       Decimal?  @db.Decimal(12, 2)
  amount     Decimal   @db.Decimal(12, 2)
  sortOrder  Int       @default(0)

  @@index([invoiceId])
  @@index([billTypeId])
  @@map("invoice_items")
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  invoiceId     BigInt
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  orgId         BigInt
  org           Organization  @relation(fields: [orgId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  transactionId String?       @db.VarChar(100)
  collector     String?       @db.VarChar(100)
  remarks       String?       @db.Text
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  /// RCP-<year>-<seq>, numbered per organisation per year (none for DEPOSIT adjustments)
  receiptNo     String?        @db.VarChar(30)
  shareToken    String?        @unique @db.VarChar(64)
  collectedById BigInt?
  collectedBy   Membership?    @relation("CollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)
  handoverId    BigInt?
  handover      CashHandover?  @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  notifications Notification[]
  claim         PaymentClaim?

  @@unique([orgId, receiptNo])
  @@index([invoiceId])
  @@index([orgId, date])
  @@index([collectedById, handoverId])
  @@map("payments")
}

model Expense {
  id          BigInt          @id @default(autoincrement())
  orgId       BigInt
  org         Organization    @relation(fields: [orgId], references: [id])
  buildingId  BigInt?
  building    Building?       @relation(fields: [buildingId], references: [id])
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?         @db.Text
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  maintenance MaintenanceRequest[]

  @@index([orgId, date])
  @@index([orgId, category])
  @@index([buildingId])
  @@map("expenses")
}

/// Anything that is rented out. Units (flats, rooms, shops...) now; vehicles in phase 6.
/// Agreements and invoices point here, so they work the same for every kind.
model Asset {
  id        BigInt       @id @default(autoincrement())
  orgId     BigInt
  org       Organization @relation(fields: [orgId], references: [id])
  kind      AssetKind
  createdAt DateTime     @default(now())

  unit        Flat?
  vehicle     Vehicle?
  agreements  Agreement[]
  invoices    Invoice[]
  maintenance MaintenanceRequest[]
  documents   Document[]

  @@index([orgId, kind])
  @@map("assets")
}

/// Who rents which asset, on what terms. The centre of the rental core.
model Agreement {
  id           BigInt          @id @default(autoincrement())
  orgId        BigInt
  org          Organization    @relation(fields: [orgId], references: [id])
  assetId      BigInt
  asset        Asset           @relation(fields: [assetId], references: [id])
  tenantId     BigInt
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  cycle        BillingCycle    @default(MONTHLY)
  /// rent per month (MONTHLY) or jama per day (DAILY, later)
  rate         Decimal         @db.Decimal(12, 2)
  startDate    DateTime        @db.Date
  endDate      DateTime?       @db.Date
  dueDay       Int             @default(10)
  noticeDays   Int             @default(60)
  noticeDate   DateTime?       @db.Date
  tdsPercent   Decimal         @default(0) @db.Decimal(5, 2)
  /// rent above Tk 25,000 a month must be paid through a bank (NBR)
  bankOnly     Boolean         @default(false)
  status       AgreementStatus @default(DRAFT)
  documentPath String?         @db.Text
  /// kind-specific terms (house clauses now; km/hour caps, fuel payer for vehicles later)
  terms        Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  revisions RateRevision[]
  deposits  DepositEntry[]
  invoices  Invoice[]
  documents Document[]
  notices   NoticeRequest[]
  days      DayEntry[]

  @@index([orgId, status])
  @@index([assetId, status])
  @@index([tenantId])
  @@map("agreements")
}

/// The VEHICLE detail of an asset (like Flat for UNIT).
model Vehicle {
  id        BigInt        @id @default(autoincrement())
  orgId     BigInt
  org       Organization  @relation(fields: [orgId], references: [id])
  assetId   BigInt        @unique
  asset     Asset         @relation(fields: [assetId], references: [id])
  type      VehicleType
  regNo     String        @db.VarChar(50)
  model     String?       @db.VarChar(100)
  year      Int?
  color     String?       @db.VarChar(30)
  chassisNo String?       @db.VarChar(50)
  engineNo  String?       @db.VarChar(50)
  /// asking jama per day / rent per month for the next agreement
  rate      Decimal?      @db.Decimal(12, 2)
  status    VehicleStatus @default(AVAILABLE)
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bookings  Booking[]

  @@unique([orgId, regNo])
  @@map("vehicles")
}

/// Exceptions on a DAILY agreement: an off day (amount 0) or a different jama. Other days cost the rate.
model DayEntry {
  id          BigInt      @id @default(autoincrement())
  agreementId BigInt
  agreement   Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  amount      Decimal     @db.Decimal(12, 2)
  reason      String?     @db.VarChar(255)
  createdById BigInt?
  createdBy   Membership? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@unique([agreementId, date])
  @@map("day_entries")
}

model RateRevision {
  id            BigInt    @id @default(autoincrement())
  agreementId   BigInt
  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime  @db.Date
  rate          Decimal   @db.Decimal(12, 2)
  reason        String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())

  @@index([agreementId, effectiveFrom])
  @@map("rate_revisions")
}

/// Deposit ledger: balance = RECEIVED - (ADJUSTED + DEDUCTED_DAMAGE + REFUNDED).
model DepositEntry {
  id          BigInt      @id @default(autoincrement())
  agreementId BigInt
  agreement   Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  type        DepositType
  amount      Decimal     @db.Decimal(12, 2)
  date        DateTime    @db.Date
  note        String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())

  @@index([agreementId])
  @@map("deposit_entries")
}

/// Sequences per organisation, e.g. key "receipt:2026" -> last receipt number used.
model OrgCounter {
  orgId BigInt
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key   String       @db.VarChar(40)
  value Int          @default(0)

  @@id([orgId, key])
  @@map("org_counters")
}

/// Outbox: rows are written inside business transactions and sent by the cron drainer.
model Notification {
  id        BigInt              @id @default(autoincrement())
  orgId     BigInt
  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(SMS)
  to        String?             @db.VarChar(20)
  template  String              @db.VarChar(30)
  lang      Lang                @default(BN)
  payload   Json
  body      String?             @db.Text
  status    NotificationStatus  @default(QUEUED)
  attempts  Int                 @default(0)
  lastError String?             @db.Text
  sendAfter DateTime            @default(now())
  sentAt    DateTime?
  /// makes queueing idempotent (reminders run daily)
  dedupeKey String?             @unique @db.VarChar(120)
  invoiceId BigInt?
  invoice   Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId BigInt?
  payment   Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now())

  @@index([status, sendAfter])
  @@index([orgId, createdAt])
  @@map("notifications")
}

/// Cash a collector (caretaker) hands over to the owner or manager; covers the payments pointing at it.
model CashHandover {
  id               BigInt       @id @default(autoincrement())
  orgId            BigInt
  org              Organization @relation(fields: [orgId], references: [id])
  fromMembershipId BigInt
  from             Membership   @relation("HandoverFrom", fields: [fromMembershipId], references: [id])
  toMembershipId   BigInt
  to               Membership   @relation("HandoverTo", fields: [toMembershipId], references: [id])
  amount           Decimal      @db.Decimal(12, 2)
  date             DateTime     @db.Date
  note             String?      @db.VarChar(255)
  createdAt        DateTime     @default(now())

  payments Payment[]

  @@index([orgId, date])
  @@map("cash_handovers")
}

/// A building-wide bill for one month (WASA, common electricity...). Saving it splits the total
/// into each billable unit's BillEntry.amount, so invoicing works unchanged.
model BuildingBill {
  id         BigInt       @id @default(autoincrement())
  orgId      BigInt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  buildingId BigInt
  building   Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  billTypeId BigInt
  billType   BillType     @relation(fields: [billTypeId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  total      Decimal      @db.Decimal(12, 2)
  note       String?      @db.VarChar(255)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([buildingId, billTypeId, month, year])
  @@index([orgId, year, month])
  @@map("building_bills")
}

model MaintenanceRequest {
  id           BigInt            @id @default(autoincrement())
  orgId        BigInt
  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId      BigInt
  asset        Asset             @relation(fields: [assetId], references: [id])
  tenantId     BigInt?
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  title        String            @db.VarChar(200)
  description  String?           @db.Text
  category     String?           @db.VarChar(50)
  /// LOW | NORMAL | URGENT
  priority     String            @default("NORMAL") @db.VarChar(10)
  status       MaintenanceStatus @default(NEW)
  assignedToId BigInt?
  assignedTo   Membership?       @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  BigInt?
  createdBy    Membership?       @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cost         Decimal?          @db.Decimal(12, 2)
  expenseId    BigInt?
  expense      Expense?          @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  /// set when the unit was marked UNDER_MAINTENANCE by this request
  blocksUnit   Boolean           @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  photos Document[]

  @@index([orgId, status])
  @@index([assetId])
  @@map("maintenance_requests")
}

/// A stored file. Served only through GET /documents/:id/file (auth + org check).
model Document {
  id            BigInt              @id @default(autoincrement())
  orgId         BigInt
  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind          DocumentKind        @default(OTHER)
  name          String              @db.VarChar(200)
  /// file name inside backend/uploads
  path          String              @db.VarChar(255)
  mime          String?             @db.VarChar(100)
  size          Int?
  tenantId      BigInt?
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId       BigInt?
  asset         Asset?              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  agreementId   BigInt?
  agreement     Agreement?          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  maintenanceId BigInt?
  maintenance   MaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  bookingId     BigInt?
  booking       Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  expiresAt     DateTime?           @db.Date
  uploadedById  BigInt?
  uploadedBy    Membership?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@index([orgId, expiresAt])
  @@index([tenantId])
  @@index([agreementId])
  @@index([assetId])
  @@index([maintenanceId])
  @@index([bookingId])
  @@map("documents")
}

/// A rent-a-car trip: the booking and its trip sheet. Its invoice has no agreement (never carried forward or auto-generated).
model Booking {
  id           BigInt        @id @default(autoincrement())
  orgId        BigInt
  org          Organization  @relation(fields: [orgId], references: [id])
  vehicleId    BigInt
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  /// the customer (person or company)
  tenantId     BigInt
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  invoiceId    BigInt?       @unique
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status       BookingStatus @default(RESERVED)
  driverName   String?       @db.VarChar(100)
  driverPhone  String?       @db.VarChar(20)
  pickup       String?       @db.VarChar(255)
  destination  String?       @db.VarChar(255)
  outstation   Boolean       @default(false)
  /// planned
  startAt      DateTime
  endAt        DateTime
  /// body rent (car + driver) per day
  dayRate      Decimal       @db.Decimal(12, 2)
  hourCap      Int           @default(10)
  kmCap        Int?
  overtimeRate Decimal       @default(0) @db.Decimal(12, 2)
  extraKmRate  Decimal       @default(0) @db.Decimal(12, 2)
  /// 0 = the customer fuels the car
  fuelPerKm    Decimal       @default(0) @db.Decimal(12, 2)
  /// trip sheet (actual)
  startKm      Int?
  endKm        Int?
  startedAt    DateTime?
  endedAt      DateTime?
  /// [{ label, amount }]: tolls, parking, driver food, lodging
  extras       Json?
  cancelCharge Decimal?      @db.Decimal(12, 2)
  notes        String?       @db.Text
  createdById  BigInt?
  createdBy    Membership?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  documents Document[]

  @@index([orgId, vehicleId, startAt])
  @@index([tenantId])
  @@map("bookings")
}

/// One-time login codes for the tenant portal (phone = 8801XXXXXXXXX). Rows also count requests for throttling.
model PortalOtp {
  id        BigInt   @id @default(autoincrement())
  phone     String   @db.VarChar(13)
  codeHash  String   @db.VarChar(100)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("portal_otps")
}

/// A tenant's logged-in device. The refresh token is stored hashed; deleting the row logs that device out.
model PortalSession {
  id          BigInt   @id @default(autoincrement())
  phone       String   @db.VarChar(13)
  refreshHash String   @unique @db.VarChar(64)
  expiresAt   DateTime
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([phone])
  @@map("portal_sessions")
}

/// "I paid by bKash": a tenant's report of a payment made outside the app, for the owner to confirm.
model PaymentClaim {
  id            BigInt        @id @default(autoincrement())
  orgId         BigInt
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId     BigInt
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId      BigInt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  transactionId String        @db.VarChar(100)
  paidOn        DateTime      @db.Date
  note          String?       @db.VarChar(255)
  status        ClaimStatus   @default(PENDING)
  paymentId     BigInt?       @unique
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reviewedById  BigInt?
  reviewedBy    Membership?   @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?       @db.VarChar(255)
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@unique([orgId, method, transactionId])
  @@index([orgId, status])
  @@index([tenantId])
  @@map("payment_claims")
}

/// A tenant's request to move out, for the owner to accept (agreement goes on notice) or decline.
model NoticeRequest {
  id           BigInt              @id @default(autoincrement())
  orgId        BigInt
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agreementId  BigInt
  agreement    Agreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenantId     BigInt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  noticeDate   DateTime            @db.Date
  moveOutDate  DateTime            @db.Date
  reason       String?             @db.VarChar(500)
  status       NoticeRequestStatus @default(PENDING)
  reviewedById BigInt?
  reviewedBy   Membership?         @relation("NoticeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?             @db.VarChar(255)
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([orgId, status])
  @@index([agreementId, status])
  @@map("notice_requests")
}
